{
  "name": "vda-soft/paywire",
  "description": "A modern PHP system for integrating various payment service providers.",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "nikic/php-parser": "^5.9",
    "phparkitect/phparkitect": "^1.3",
    "phpmetrics/phpmetrics": "^2.11",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.1",
    "phpstan/phpstan-webmozart-assert": "^2.0",
    "phpunit/phpunit": "^13.4",
    "symfony/phpunit-bridge": "^8.1",
    "symplify/monorepo-builder": "^12.7",
    "vda-soft/paywire-bridge-symfony": "dev-main",
    "vda-soft/paywire-core": "dev-main",
    "vda-soft/paywire-payu": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "src/PayWire/Core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "src/PayWire/Bridge/Symfony",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "src/PayWire/Gateway/PayU",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "src/PayWire/Gateway/Offline",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "PayWire\\Core\\Tests\\": "src/PayWire/Core/tests/",
      "PayWire\\Bridge\\Symfony\\Tests\\": "src/PayWire/Bridge/Symfony/tests/",
      "PayWire\\Gateway\\PayU\\Tests\\": "src/PayWire/Gateway/PayU/tests/",
      "PayWire\\Gateway\\Offline\\Tests\\": "src/PayWire/Gateway/Offline/tests/",
      "PayWire\\Tools\\PHPStan\\": "tools/PHPStan/"

    }
  },
  "scripts": {
    "phpunit": "phpunit",
    "phpstan": "phpstan analyse",
    "csfixer": "php-cs-fixer fix --no-interaction --verbose",
    "architecture": "phparkitect check",
    "metrics": "phpmetrics --format=json --report-file=var/codecharta-metrics.json src/",
    "metrics:html": "phpmetrics --report-html=var/metrics src/",
    "codecharta:generate": "php bin/codecharta-converter.php var/metrics/js/latest.json var/codecharta.cc.json",
    "codecharta:serve": "docker run --rm -p 4200:4200 -v $(pwd):/data codecharta/codecharta -i /data/var/codecharta.cc.json --server",
    "codecharta:export": "docker run --rm -v $(pwd):/data codecharta/codecharta -i /data/var/codecharta.cc.json -o /data/var/codecharta-analysis.cc.json",
    "ci": [
      "@csfixer",
      "@phpstan",
      "@architecture",
      "@phpunit"
    ]
  }
}
